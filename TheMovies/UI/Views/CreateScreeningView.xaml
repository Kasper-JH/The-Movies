<!--
    SRP: UI til oprettelse af forestilling (UC2).
    Dato og klokkeslæt er samlet under ét label "Spilletidspunkt",
    og der vises et beregnet sluttidspunkt (jf. UC2 trin 7).
    Ugyldigt klokkeslæt giver en fejlbesked i statusfeltet.
-->
<Window x:Class="TheMovies.UI.Views.CreateScreeningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Movies - Opret Forestilling"
        Height="520" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Film (hentes fra repository) -->
        <Label Grid.Row="0" Grid.Column="0" Content="Film:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableMovies}"
                  SelectedItem="{Binding SelectedMovie}" DisplayMemberPath="Title"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Biograf (fast data fra CinemaSeed.cs) -->
        <Label Grid.Row="1" Grid.Column="0" Content="Biograf:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableCinemas}"
                  SelectedItem="{Binding SelectedCinema}" DisplayMemberPath="Name"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Sal (opdateres når biograf vælges) -->
        <Label Grid.Row="2" Grid.Column="0" Content="Sal:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableHalls}"
                  SelectedItem="{Binding SelectedHall}" DisplayMemberPath="HallNumber"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Instruktør (tilføjet til Movie.cs under UC2) -->
        <Label Grid.Row="3" Grid.Column="0" Content="Instruktør:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5" VerticalAlignment="Center"/>

        <!-- Premieredato (tilføjet til Movie.cs under UC2)-->
        <Label Grid.Row="4" Grid.Column="0" Content="Premieredato:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding PremiereDate}"
                    Margin="0,5" VerticalAlignment="Center"/>

        <!-- Spilletidspunkt: dato + klokkeslæt -->
        <Label Grid.Row="5" Grid.Column="0" Content="Spilletidspunkt:" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,5" VerticalAlignment="Center">
            <DatePicker SelectedDate="{Binding ScreeningDate}" Width="150" VerticalAlignment="Center"/>
            <TextBlock Text=" kl. " VerticalAlignment="Center" Margin="5,0"/>
            <TextBox Text="{Binding ScreeningTime, UpdateSourceTrigger=PropertyChanged}" 
                     Width="80" VerticalAlignment="Center" ToolTip="Format: TT:MM"/>
        </StackPanel>

        <!-- Beregnet sluttidspunkt (jf. UC2 trin 7) -->
        <Label Grid.Row="6" Grid.Column="0" Content="Sluttidspunkt (beregnet):" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CalculatedEndTime}" 
                   VerticalAlignment="Center" Margin="0,5" FontWeight="Bold"/>

        <!-- Opret-knap (deaktiveres indtil alle felter er udfyldt) -->
        <Button Grid.Row="7" Grid.ColumnSpan="2" Content="Opret Forestilling"
                Command="{Binding CreateScreeningCommand}"
                Margin="0,15" Height="30" HorizontalAlignment="Center" Width="180"/>

        <!-- Statusbesked (feedback til brugeren) -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                   Margin="0,10" TextWrapping="Wrap"/>
    </Grid>
</Window>