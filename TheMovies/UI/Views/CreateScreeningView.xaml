<!--
    SRP: Denne fil definerer kun UI-layoutet og bindinger til ViewModel (UC2 - Opret forestilling).
    DataContext sættes i App.xaml.cs (composition root) fordi ViewModel kræver repositories via constructor.
-->
<Window x:Class="TheMovies.UI.Views.CreateScreeningView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Movies - Opret Forestilling"
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Film -->
        <Label Grid.Row="0" Grid.Column="0" Content="Film:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableMovies}"
                  SelectedItem="{Binding SelectedMovie}" DisplayMemberPath="Title"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Biograf -->
        <Label Grid.Row="1" Grid.Column="0" Content="Biograf:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableCinemas}"
                  SelectedItem="{Binding SelectedCinema}" DisplayMemberPath="Name"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Sal -->
        <Label Grid.Row="2" Grid.Column="0" Content="Sal:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableHalls}"
                  SelectedItem="{Binding SelectedHall}" DisplayMemberPath="HallNumber"
                  Margin="0,5" VerticalAlignment="Center"/>

        <!-- Instruktør -->
        <Label Grid.Row="3" Grid.Column="0" Content="Instruktør:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5" VerticalAlignment="Center"/>

        <!-- Premieredato -->
        <Label Grid.Row="4" Grid.Column="0" Content="Premieredato:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding PremiereDate}"
                    Margin="0,5" VerticalAlignment="Center"/>

        <!-- Spilledato -->
        <Label Grid.Row="5" Grid.Column="0" Content="Spilledato:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding ScreeningDate}"
                    Margin="0,5" VerticalAlignment="Center"/>

        <!-- Klokkeslæt -->
        <Label Grid.Row="6" Grid.Column="0" Content="Klokkeslæt (TT:MM):" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ScreeningTime, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,5" VerticalAlignment="Center"/>

        <!-- Opret-knap -->
        <Button Grid.Row="7" Grid.ColumnSpan="2" Content="Opret Forestilling"
                Command="{Binding CreateScreeningCommand}"
                Margin="0,15" Height="30" HorizontalAlignment="Center" Width="180"/>

        <!-- Status-besked -->
        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                   Margin="0,10" TextWrapping="Wrap"/>
    </Grid>
</Window>
