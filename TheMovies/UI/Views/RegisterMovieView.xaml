<!--
    SRP: UI til registrering af film (UC1).
    DataContext sættes i MainMenuViewModel, når vinduet oprettes.
-->
<Window x:Class="TheMovies.UI.Views.RegisterMovieView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Movies - Registrer film" 
        Height="450" Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Titel -->
        <Label Grid.Row="0" Grid.Column="0" Content="Titel:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5" VerticalAlignment="Center"/>

        <!-- Varighed -->
        <Label Grid.Row="1" Grid.Column="0" Content="Varighed:" VerticalAlignment="Center"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Time(r):"
                   HorizontalAlignment="Left" />

            <TextBox Grid.Column="1"
                     Margin="0,5" 
                     PreviewTextInput="NumberOnly"
                     Text="{Binding DurationHours, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Grid.Column="2"
                   Content="Minutter:"
                   VerticalAlignment="Center" />

            <TextBox Grid.Column="3"
                   Margin="0,5" 
                   PreviewTextInput="NumberOnly"
                   Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

            <!-- Genre -->
            <Label Grid.Row="2" Grid.Column="0" Content="Genre:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,5" VerticalAlignment="Center"/>

            <!-- Registrer-knap -->
            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Registrer film" 
                Command="{Binding RegisterMovieCommand}"
                Margin="0,15" Height="30" HorizontalAlignment="Center" Width="150"/>

            <!-- Statusbesked -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" 
                   HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                   Margin="0,10"/>
    </Grid>
</Window>