<!--
    SRP: Startmenu – UI til at vælge mellem UC1 og UC2.
    DataContext er MainMenuViewModel, som styrer al logik.
-->
<Window x:Class="TheMovies.UI.Views.MainMenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Movies - Hovedmenu" Height="220" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
        <!-- UC1: Registrer film -->
        <Button Content="Registrer film" Width="200" Height="40" Margin="5"
                Command="{Binding RegisterMovieCommand}"/>

        <!-- UC2: Opret forestilling – deaktiveres automatisk via CanExecute -->
        <Button Content="Opret forestilling" Width="200" Height="40" Margin="5"
                Command="{Binding CreateScreeningCommand}"/>

        <!-- Statusbesked – styres af ViewModel -->
        <TextBlock Text="{Binding StatusMessage}" Margin="10,5" 
                   HorizontalAlignment="Center" FontWeight="Bold"/>
    </StackPanel>
</Window>